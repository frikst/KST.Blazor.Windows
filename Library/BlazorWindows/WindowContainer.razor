@using Microsoft.AspNetCore.Components.Web
@using KST.Blazor.Windows.Internal

@if (this.aRequestWindowManagementPermission)
{
    <div class="window-management-api-request">
        Permission is needed for the application to be able to enumerate available screens.
        <button class="proceed" @onclick="this.AcceptWindowManagementAPIPermission">Proceed</button>
        <button class="dismiss" @onclick="this.DismissWindowManagementAPIPermission">🗙</button>
    </div>
}

<div style="display: none" role="none">
    @if (this.WindowManagement is WindowManagementImpl impl)
    {
        foreach (var window in impl.Windows)
        {
            <InternalWindowHandlerComponent Window="@window" @key="window.Id" />
        }
    }
</div>
