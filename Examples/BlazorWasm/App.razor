@using KST.Blazor.Windows.Examples
<WindowContainer />

<Router AppAssembly="@typeof(App).Assembly" AdditionalAssemblies="[typeof(ExampleAttribute).Assembly]" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)"/>
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
</Router>
