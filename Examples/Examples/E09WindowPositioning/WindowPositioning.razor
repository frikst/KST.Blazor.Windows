@page "/window-positioning"
@using KST.Blazor.Windows.Examples.Components
@attribute [Example("Window positioning")]
@inject IWindowManagement WindowManagement

<h3>Window positioning</h3>

<SelectScreen @bind-Screen="this.aSelectedScreen" />
<br />
<SelectPosition @bind-Position="this.aSelectedPosition" />
<br />
<button class="btn btn-primary" @onclick="this.OpenWindow">Open new window</button>

@code {
    private IScreen? aSelectedScreen;
    private WindowPosition aSelectedPosition = new WindowPositionDefault();

    private async Task OpenWindow()
    {
        var position = this.aSelectedPosition;

        if (this.aSelectedScreen is not null && position is WindowPositionAtScreen positionAtScreen)
            position = positionAtScreen with { Screen = this.aSelectedScreen };

        await this.WindowManagement.OpenWindowAsync<WindowPositioning>(new NewWindowOptions { InitialPosition = position });
    }
}
